  "implementation_notes": {
    "for_cursor": [
      "Trajectory library = hangi hareket nasıl. Motor trajectory_override okuduğunda buraya bakar.",
      "Hitbox library = hangi çarpışma alanı nasıl. Motor base_hitbox okuduğunda buraya bakar.",
      "Matrix = hangi trajectory hangi hitbox ile uyumlu. Uyumsuzsa motor hata verir.",
      "Animation library = hangi animasyon frame data. Motor animation_type okuduğunda buraya bakar.",
      "VFX binding = hangi trajectory/hitbox/animasyon için hangi VFX prefab. Motor asset yüklerken buraya bakar.",
      "Bu dosya element sisteminden bağımsız. Element sistemi sadece hangi trajectory/hitbox/animation kullanacağını söyler."
    ],
    "motor_integration_order": [
      "1. trajectory_override okunduğunda trajectory_library'den çek",
      "2. base_hitbox okunduğunda hitbox_library'den çek",
      "3. İkisini matrix'te kontrol et — uyumlu mu?",
      "4. animation_type okunduğunda animation_library'den frame data çek",
      "5. damage_applied_at_frame frame'inde hasar uygula",
      "6. spawn_vfx_at_frame frame'inde VFX oluştur",
      "7. vfx_binding kurallarına göre VFX prefab seç",
      "8. Asset yüklenmemişse placeholder göster (renkli küp/küre)"
    ],
    "asset_missing_handling": {
      "if_vfx_missing": "Renkli primitive göster (element_color)",
      "if_animation_missing": "Basit animasyon (scale + rotate)",
      "if_sound_missing": "Sessiz çalış",
      "log_warning": true
    }
  },

