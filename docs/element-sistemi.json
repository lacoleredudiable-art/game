{
  "system": {
    "version": "4.2",
    "description": "Bağlayıcı dövüş sistemi (element rün dili) v4.2. Eski dovus-sistemi.md arşivde; buradan sıfırdan ilerlenir. Anti-ladder: uzunluk hasar/poise çarpmaz; sıfat vergisi; 4'lü dar commit anahtarı.",
    "design_intent": {
      "anti_ladder": "Uzunluk güç değil, durumsal araçtır. 2'li temel hasar/işlev, 3'lü spesifik mekanik (kozmetik kimlik + şekil), 4'lü dar silüet. Hasar uzunlukla artmaz.",
      "adjective_tax": "Sıkı kural: sıfat yeni işlev/şekil ekliyorsa damage_mult MUTLAKA <= 0.9 (asla 1.0 + ekstra). Taban hasarı 1.0 üstüne çıkaran buff yok. Saf vergi sıfatları (0.5–0.85) olduğu gibi kalır.",
      "no_length_poise_scale": "Uzunluk poise ölçeklemez. poise_damage yalnızca fiilden (verb) gelir; length.poise_damage_mult her uzunlukta 1.0.",
      "four_is_narrow_key_not_ulti_damage": "4'lü ulti hissi hasardan değil; commit/risk/şekil darlığından gelir (yüksek cast_time, rooted mobility, dar silüet).",
      "engine_rule": "Soyut kavramların tamamı sayısal bir engine_modifier ile eşleşir."
    },
    "binding": true,
    "replaces": [
      "docs/dovus-sistemi.md (arsiv)",
      "alfa pentagon-cümle dövüş spec"
    ]
  },
  "scaling_economy": {
    "lengths": {
      "2": {
        "role": "Temel",
        "cast_time_mult": 1.0,
        "resource_cost_mult": 1.0,
        "damage_mult": 1.0,
        "poise_damage_mult": 1.0,
        "mobility": "free_move"
      },
      "3": {
        "role": "Durumsal",
        "cast_time_mult": 1.4,
        "resource_cost_mult": 1.5,
        "damage_mult": 1.0,
        "poise_damage_mult": 1.0,
        "mobility": "slowed_move"
      },
      "4": {
        "role": "Dar Cevap",
        "cast_time_mult": 2.0,
        "resource_cost_mult": 2.2,
        "damage_mult": 1.0,
        "poise_damage_mult": 1.0,
        "mobility": "rooted"
      }
    },
    "mobility_resolution": {
      "rule": "final_mobility = most_restrictive(length.mobility, verb.cast_mobility)",
      "order_least_to_most_restrictive": [
        "free_move",
        "slowed_move",
        "rooted"
      ],
      "exception": {
        "verb_families": [
          "motion"
        ],
        "rule": "motion ailesi length.mobility yok sayar; yalnızca verb.cast_mobility kullanılır (4-rün dash çalışsın diye)"
      }
    }
  },
