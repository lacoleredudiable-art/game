  "mobility_resolution": {
    "rule": "final_mobility = most_restrictive(length.mobility, verb.cast_mobility)",
    "order_least_to_most_restrictive": [
      "free_move",
      "slowed_move",
      "rooted"
    ],
    "exception": {
      "verb_families": [
        "motion"
      ],
      "rule": "motion ailesi length.mobility yok sayar; yalnızca verb.cast_mobility kullanılır (4-rün dash çalışsın diye)"
    }
  },
  "changelog": {
    "from": "4.1_Full",
    "to": "4.2",
    "fixes": [
      "length poise_damage_mult → 1.0 (no_length_poise_scale)",
      "mobility_resolution: most_restrictive(length, verb); motion ailesi istisna",
      "adjective_tax: yogunlastirma/patlatma/esneklik/saflik/sabitleme/geciktirme/tetikleme",
      "keskinlik: crit_chance_add kaldırıldı",
      "yokluk: execute_threshold kaldırıldı (hollow silüet)",
      "kritik_vurus.base_damage_value = saldiri (40); poise iğne için 12",
      "secondary_effects: mechanical=false, flavor_tint only",
      "varlik_silme: damage 45, poise 28, rarity via commit"
    ]
  }
