  "secondary_effects": {
    "description": "3'lü komboda 3. rün (ana element) kimlik rengi: yalnızca görsel/işitsel flavor_tint. Mekanik status (burn/cleanse/haste/shield/blind/weaken) UYGULAMAZ.",
    "mechanical": false,
    "Ateş": {
      "flavor_tint": "ember_glow",
      "mechanical": false,
      "description": "VFX/SFX kimliği: köz parıltısı ve yanma sesi — yanma status'u vermez"
    },
    "Su": {
      "flavor_tint": "ripple_sheen",
      "mechanical": false,
      "description": "VFX/SFX kimliği: su dalgası parıltısı — debuff silmez"
    },
    "Hava": {
      "flavor_tint": "wind_streak",
      "mechanical": false,
      "description": "VFX/SFX kimliği: rüzgâr izi — hareket hızı vermez"
    },
    "Toprak": {
      "flavor_tint": "stone_dust",
      "mechanical": false,
      "description": "VFX/SFX kimliği: taş tozu — kalkan vermez"
    },
    "Aydınlık": {
      "flavor_tint": "flare_flash",
      "mechanical": false,
      "description": "VFX/SFX kimliği: parlama flaşı — körlük uygulamır"
    },
    "Karanlık": {
      "flavor_tint": "shadow_veil",
      "mechanical": false,
      "description": "VFX/SFX kimliği: gölge örtüsü — zayıflatma uygulamır"
    }
  },
