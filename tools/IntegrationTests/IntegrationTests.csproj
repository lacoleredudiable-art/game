<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IntegrationTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;SWEEP_HEADLESS</DefineConstants>
    <NoWarn>$(NoWarn);CS0067;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS8321;CS0109</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\App\**\*.cs" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\Game\**\*.cs" Exclude="..\..\unity\Assets\Scripts\Game\Editor\**" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\SweepV2\Shim\**\*.cs" Link="Shim\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
