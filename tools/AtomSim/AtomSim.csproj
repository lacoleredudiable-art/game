<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>AtomSim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Oyunla aynı motor: Core/Mechanic + JSON okuyucusu link'lenir, kopyası tutulmaz. -->
  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Scripts\Core\Mechanic\*.cs" Link="Core\Mechanic\%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\Core\Grammar\MiniJson.cs" Link="Core\Grammar\MiniJson.cs" />
    <Compile Include="..\..\unity\Assets\Scripts\Core\Tuning\SkillVisualTuning.cs" Link="Core\Tuning\SkillVisualTuning.cs" />
  </ItemGroup>

</Project>
