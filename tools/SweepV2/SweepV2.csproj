<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SweepV2</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- PlaySweep.cs editörde derlenir; başsız koşucu onu değiştirmeden aynı kontrollerle çalıştırır. -->
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;SWEEP_HEADLESS</DefineConstants>
    <NoWarn>$(NoWarn);CS0067;CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS8321;CS0109</NoWarn>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    Oyunun kendisi değişmeden derlenir: Core + Game (Editor hariç) + Editor/PlaySweep.cs.
    UnityEngine/UnityEditor yerine Shim/ klasöründeki başsız kopya bağlanır.
  -->
  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\App\**\*.cs" Link="App\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\Game\**\*.cs" Exclude="..\..\unity\Assets\Scripts\Game\Editor\**" Link="Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\unity\Assets\Scripts\Game\Editor\PlaySweep.cs" Link="Game\Editor\PlaySweep.cs" />
    <Compile Include="Shim\**\*.cs" />
    <Compile Include="Host\**\*.cs" />
  </ItemGroup>

</Project>
